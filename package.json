{
  "name": "markdown-reader",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "wrangler dev --config wrangler.example.toml --port 8787",
    "test": "node --test tests/*.test.js",
    "check": "npm test && npm run build && node scripts/check-release.js",
    "deploy": "npm run check && wrangler deploy"
  },
  "dependencies": {
    "dompurify": "3.4.15",
    "github-slugger": "2.0.0",
    "highlight.js": "11.12.0",
    "katex": "0.18.7",
    "marked": "18.0.12",
    "marked-katex-extension": "5.1.12",
    "mermaid": "11.17.2"
  },
  "devDependencies": {
    "jsdom": "30.0.1",
    "vite": "8.2.2",
    "wrangler": "4.130.0"
  },
  "overrides": {
    "sharp": "0.35.4"
  }
}
